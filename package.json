{
  "name": "cloudbricks-dev",
  "version": "1.0.0",
  "private": true,
  "description": "cloudbricks.dev - Hugo site with a custom shadcn/ui theme (Tailwind CSS v4)",
  "scripts": {
    "dev": "hugo server --buildDrafts",
    "build": "hugo --gc --minify",
    "search": "hugo --gc --minify --destination .search-index && pagefind --site .search-index && node tools/copy-search-index.mjs",
    "og": "python tools/og-image.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  }
}